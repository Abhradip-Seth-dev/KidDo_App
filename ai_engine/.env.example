# AI Engine Environment
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./ai_engine_dev.db
SECRET_KEY=change-this-in-production-use-32-char-secret

# When backend is ready, set this to validate tokens issued by Node.js
NODE_BACKEND_URL=http://localhost:3000

# CORS - allow Flutter dev
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://10.0.2.2:8000"]

# Scoring rules (configurable without code changes)
BEGINNER_CORRECT_POINTS=5
BEGINNER_INCORRECT_POINTS=-2
INTERMEDIATE_CORRECT_POINTS=10
INTERMEDIATE_INCORRECT_POINTS=-5
EXPERT_CORRECT_POINTS=15
EXPERT_INCORRECT_POINTS=-8
HINT_PENALTY=1

# Adaptive engine knobs
DIFFICULTY_WINDOW=5
LEVEL_UP_THRESHOLD=4
LEVEL_DOWN_THRESHOLD=1
RECENT_QUESTION_LOOKBACK=10
MIN_MASTERY_EVIDENCE=3
