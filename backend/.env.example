# Server Configuration
PORT=3000

# PostgreSQL Connection String (Docker or Local)
# Docker: postgresql://kiddo_user:kiddo_password@localhost:5432/kiddodb?schema=public
DATABASE_URL="postgresql://kiddo_user:kiddo_password@localhost:5432/kiddodb?schema=public"

# JWT Configuration
JWT_SECRET=kiddo_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Node Environment
NODE_ENV=development
